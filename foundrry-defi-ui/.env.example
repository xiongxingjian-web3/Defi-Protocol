# 复制为 .env.local 后填写，勿将 .env.local 提交到 Git
# copy .env.example .env.local

# WalletConnect Cloud Project ID（https://cloud.walletconnect.com）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Sepolia RPC（与合约部署网络一致）
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# The Graph 子图 HTTP 端点（风险列表功能）
NEXT_PUBLIC_SUBGRAPH_URL=

# CoinGecko Demo API Key（可选，减轻限流）
COINGECKO_API_KEY=

# 以下为本地演示用，生产可删除
# NEXT_PUBLIC_DEV_UNDERWATER_FIXTURE=1
# NEXT_PUBLIC_DEV_UNDERWATER_ADDR=
